<Window x:Class="PitlaneHQ.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:PitlaneHQ.Desktop"
        Title="Pitlane HQ" Width="1360" Height="860" MinWidth="900" MinHeight="600"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource FBody}" Foreground="{StaticResource Fg}"
        Loaded="OnLoaded" Closing="OnClosing" SizeChanged="OnWinSize" StateChanged="OnWinState">
    <WindowChrome.WindowChrome>
        <!-- no caption of its own: the app's header is the title bar (drag, double-click, its buttons), like the web on the PC -->
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- the header, like the web's: the logo and the name, the game's state, the version, the main tabs
             (Home, Analysis, Telemetry, Overlays, Community, Account), Settings and the window's own buttons -->
        <!-- not shown: the window is the app itself, exactly the web (its own header, tabs and window buttons) -->
        <Border Grid.Row="0" Visibility="Collapsed" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel Margin="18,0,0,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <RadioButton x:Name="NavSettings" GroupName="nav" Style="{StaticResource NavButton}" Tag="settings" Checked="OnNav" Margin="8,0,10,0"
                                 local:Ui.Icon="M 9.671,4.136 A 2.34,2.34 0 0 1 14.33,4.136 A 2.34,2.34 0 0 0 17.649,6.051 A 2.34,2.34 0 0 1 19.979,10.084 A 2.34,2.34 0 0 0 19.979,13.915 A 2.34,2.34 0 0 1 17.649,17.948 A 2.34,2.34 0 0 0 14.33,19.863 A 2.34,2.34 0 0 1 9.671,19.863 A 2.34,2.34 0 0 0 6.351,17.948 A 2.34,2.34 0 0 1 4.021,13.915 A 2.34,2.34 0 0 0 4.021,10.084 A 2.34,2.34 0 0 1 6.35,6.051 A 2.34,2.34 0 0 0 9.669,4.136 M 9,12 A 3,3 0 1 0 15,12 A 3,3 0 1 0 9,12 Z"/>
                    <Button Style="{StaticResource WinButton}" Content="&#xE921;" Click="OnMinimize"/>
                    <Button Style="{StaticResource WinButton}" Content="&#xE922;" Click="OnMaximize"/>
                    <Button Style="{StaticResource WinClose}" Content="&#xE8BB;" Click="OnClose"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="img/logo.png" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                    <TextBlock x:Name="BrandText" Text="PITLANE HQ" Foreground="{StaticResource Fg}" FontFamily="{StaticResource FDisplay}" FontWeight="Bold" FontSize="24" VerticalAlignment="Center" Margin="9,0,0,0"/>
                    <!-- the game's state (.conn): live in green, waiting in yellow, the demo in amber -->
                    <Border x:Name="ConnPill" BorderBrush="{StaticResource Warn}" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ConnPillDot" Width="7" Height="7" Fill="{StaticResource Warn}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="ConnPillText" Text="…" Foreground="{StaticResource Warn}" FontFamily="{StaticResource FData}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="VersionPill" Visibility="Collapsed" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="999" Padding="7,4" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" Text="" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" FontFamily="{StaticResource FData}"/>
                    </Border>
                    <Border x:Name="DemoPill" Visibility="Collapsed" Background="{StaticResource Accent}" CornerRadius="999" Padding="8,4" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="DemoText" Text="DEMO DATA" Foreground="{StaticResource AccentInk}" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource FData}"/>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="Tabs" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <RadioButton x:Name="NavHome" GroupName="nav" Style="{StaticResource NavButton}" Content="Home" Tag="home" IsChecked="True" Checked="OnNav" local:Ui.Icon="M 15,21 L 15,13 A 1,1 0 0 0 14,12 L 10,12 A 1,1 0 0 0 9,13 L 9,21 M 3,10 A 2,2 0 0 1 3.709,8.472 L 10.709,2.472 A 2,2 0 0 1 13.291,2.472 L 20.291,8.472 A 2,2 0 0 1 21,10 L 21,19 A 2,2 0 0 1 19,21 L 5,21 A 2,2 0 0 1 3,19 Z"/>
                    <RadioButton x:Name="NavAnalysis" GroupName="nav" Style="{StaticResource NavButton}" Content="Analysis" Tag="laps" Checked="OnNav" local:Ui.Icon="M 3,3 L 3,19 A 2,2 0 0 0 5,21 L 21,21 M 19,9 L 14,14 L 10,10 L 7,13"/>
                    <RadioButton x:Name="NavLive" GroupName="nav" Style="{StaticResource NavButton}" Content="Telemetry" Tag="live" Checked="OnNav" local:Ui.Icon="M 12,14 L 16,10 M 3.34,19 A 10,10 0 1 1 20.66,19"/>
                    <RadioButton x:Name="NavOverlays" GroupName="nav" Style="{StaticResource NavButton}" Content="Overlays" Tag="overlays" Checked="OnNav" local:Ui.Icon="M 12,3 L 21,7.5 L 12,12 L 3,7.5 Z M 3,12 L 12,16.5 L 21,12 M 3,16.5 L 12,21 L 21,16.5"/>
                    <RadioButton x:Name="NavCommunity" GroupName="nav" Style="{StaticResource NavButton}" Content="Community" Tag="community" Checked="OnNav" local:Ui.Icon="M 16,21 L 16,19 A 4,4 0 0 0 12,15 L 6,15 A 4,4 0 0 0 2,19 L 2,21 M 16,3.128 A 4,4 0 0 1 16,10.872 M 22,21 L 22,19 A 4,4 0 0 0 19,15.13 M 5,7 A 4,4 0 1 0 13,7 A 4,4 0 1 0 5,7 Z"/>
                    <RadioButton x:Name="NavAccount" GroupName="nav" Style="{StaticResource NavButton}" Content="Account" Tag="me" Checked="OnNav" local:Ui.Icon="M 19,21 L 19,19 A 4,4 0 0 0 15,15 L 9,15 A 4,4 0 0 0 5,19 L 5,21 M 8,7 A 4,4 0 1 0 16,7 A 4,4 0 1 0 8,7 Z"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid>
                <!-- the screens not native yet: the app inside a WebView -->
                <!-- the app itself (web/dist, served by the engine): every screen, exactly as on the web; the 6 px margin
                     leaves the window's resize borders to the window (a child window would take the mouse there) -->
                <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#11151B" Margin="6"/>

                <!-- HOME (native) -->
                <ScrollViewer x:Name="HomeView" VerticalScrollBarVisibility="Auto" Padding="28,20,18,24" Background="{StaticResource Bg}">
                    <StackPanel>
                        <TextBlock x:Name="HomeTitle" Style="{StaticResource H1}" Text="HOME"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="GameLabel" Style="{StaticResource Label}" Text="GAME"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="ConnDot" Width="10" Height="10" Fill="{StaticResource Bad}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ConnText" Style="{StaticResource Value}" Text="Waiting for iRacing"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="TrackLabel" Style="{StaticResource Label}" Text="TRACK"/>
                                    <TextBlock x:Name="TrackText" Style="{StaticResource Value}" Text="–"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="CarLabel" Style="{StaticResource Label}" Text="CAR"/>
                                    <TextBlock x:Name="CarText" Style="{StaticResource Value}" Text="–"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <WrapPanel x:Name="HomeItems" Margin="0,0,0,8"/>
                        <TextBlock x:Name="RatingsTitle" Style="{StaticResource CardTitle}" Text="LICENCE SUMMARY" Margin="0,8,0,8" Visibility="Collapsed"/>
                        <WrapPanel x:Name="RatingsList"/>
                        <TextBlock x:Name="RatingsNote" Style="{StaticResource Note}" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed"/>
                        <WrapPanel x:Name="StatsList" Margin="0,0,0,4" Visibility="Collapsed"/>
                        <TextBlock x:Name="RacesTitle" Style="{StaticResource CardTitle}" Text="RECENT RACES" Margin="0,8,0,8"/>
                        <StackPanel x:Name="RacesList"/>
                        <TextBlock x:Name="RacesEmpty" Style="{StaticResource Note}" Text="Your races appear here after you finish one." Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- TELEMETRY (native) -->
                <ScrollViewer x:Name="LiveView" VerticalScrollBarVisibility="Auto" Padding="28,20,18,24" Background="{StaticResource Bg}" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="LiveTitle" Style="{StaticResource H1}" Text="TELEMETRY"/>
                            <TextBlock x:Name="LiveTrack" Style="{StaticResource Note}" VerticalAlignment="Bottom" Margin="14,0,0,8"/>
                        </StackPanel>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <Button x:Name="SetBeepGo" DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" VerticalAlignment="Center" Margin="14,0,0,0" Content="Turn it on and set it" Click="OnSetRevBeep"/>
                                <StackPanel>
                                    <TextBlock x:Name="SetBeepT" Style="{StaticResource CardTitle}" Margin="0,0,0,4" Text="REV BEEP"/>
                                    <TextBlock x:Name="SetBeepNote" Style="{StaticResource Note}" Text="A beep to change up at the revs you choose, for each car: the same RPM for every gear or one for each, or at iRacing's shift lights."/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <WrapPanel x:Name="LiveItems" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="7*"/>
                                <ColumnDefinition Width="5*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <!-- gear, speed, pedals, shift lights -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,28,0">
                                                <TextBlock x:Name="GearLabel" Style="{StaticResource Label}" Margin="0" Text="GEAR"/>
                                                <TextBlock x:Name="GearText" Text="N" Foreground="{StaticResource Fg}" FontFamily="{StaticResource FDisplay}" FontWeight="Bold" FontSize="72" LineHeight="70" LineStackingStrategy="BlockLineHeight"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock x:Name="SpeedLabel" Style="{StaticResource Label}" Margin="0" Text="SPEED"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="SpeedText" Text="0" Foreground="{StaticResource Fg}" FontFamily="{StaticResource FDisplay}" FontWeight="Bold" FontSize="52"/>
                                                    <TextBlock x:Name="SpeedUnit" Text="km/h" Foreground="{StaticResource Muted}" FontFamily="{StaticResource FDisplay}" FontSize="16" VerticalAlignment="Bottom" Margin="6,0,0,12"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                                <Border Width="16" Height="72" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Margin="0,0,8,0">
                                                    <Border x:Name="CluBar" VerticalAlignment="Bottom" Height="0" Background="{StaticResource Blue}" CornerRadius="2"/>
                                                </Border>
                                                <Border Width="16" Height="72" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Margin="0,0,8,0">
                                                    <Border x:Name="BrkBar" VerticalAlignment="Bottom" Height="0" Background="{StaticResource Bad}" CornerRadius="2"/>
                                                </Border>
                                                <Border Width="16" Height="72" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3">
                                                    <Border x:Name="ThrBar" VerticalAlignment="Bottom" Height="0" Background="{StaticResource Good}" CornerRadius="2"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        <UniformGrid x:Name="RpmLights" Rows="1" Columns="16" Height="16" Margin="0,12,0,6"/>
                                        <Grid>
                                            <TextBlock x:Name="RpmText" Style="{StaticResource Label}" Margin="0" Text="RPM 0"/>
                                            <TextBlock x:Name="ShiftText" Style="{StaticResource Label}" Margin="0" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <!-- lap timing -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock x:Name="CurLabel" Style="{StaticResource Label}" Margin="0" Text="CURRENT LAP"/>
                                                <TextBlock x:Name="CurText" Text="–" Foreground="{StaticResource Fg}" FontFamily="{StaticResource FData}" FontSize="24"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock x:Name="DeltaLabel" Style="{StaticResource Label}" Margin="0" Text="DELTA TO BEST"/>
                                                <TextBlock x:Name="DeltaText" Text="–" Foreground="{StaticResource Fg}" FontFamily="{StaticResource FData}" FontSize="24"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock x:Name="BestLabel" Style="{StaticResource Label}" Margin="0" Text="BEST LAP"/>
                                                <TextBlock x:Name="BestText" Text="–" Foreground="{StaticResource Pb}" FontFamily="{StaticResource FData}" FontSize="24"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock x:Name="LastLabel" Style="{StaticResource Label}" Margin="0" Text="LAST LAP"/>
                                                <TextBlock x:Name="LastText" Text="–" Foreground="{StaticResource Fg}" FontFamily="{StaticResource FData}" FontSize="24"/>
                                            </StackPanel>
                                        </UniformGrid>
                                        <ProgressBar x:Name="LapProgress" Height="8" Margin="0,12,0,0" Minimum="0" Maximum="1" Background="{StaticResource Surface2}" Foreground="{StaticResource Accent}" BorderBrush="{StaticResource Line}"/>
                                    </StackPanel>
                                </Border>
                                <!-- fuel -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock x:Name="FuelTitle" Style="{StaticResource CardTitle}" Text="FUEL"/>
                                        <UniformGrid Columns="3">
                                            <StackPanel>
                                                <TextBlock x:Name="FuelTank" Text="–" Foreground="{StaticResource Fg}" FontFamily="{StaticResource FData}" FontSize="24"/>
                                                <TextBlock x:Name="FuelTankL" Style="{StaticResource Note}" Text="in tank"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock x:Name="FuelLaps" Text="–" Foreground="{StaticResource Fg}" FontFamily="{StaticResource FData}" FontSize="24"/>
                                                <TextBlock x:Name="FuelLapsL" Style="{StaticResource Note}" Text="laps of fuel"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock x:Name="FuelPer" Text="–" Foreground="{StaticResource Fg}" FontFamily="{StaticResource FData}" FontSize="24"/>
                                                <TextBlock x:Name="FuelPerL" Style="{StaticResource Note}" Text="per lap"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <!-- the relative -->
                            <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock x:Name="RelTitle" Style="{StaticResource CardTitle}" Text="RELATIVE"/>
                                    <StackPanel x:Name="RelRows"/>
                                    <TextBlock x:Name="RelEmpty" Style="{StaticResource Note}" Text="Waiting for cars on track" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- OVERLAYS (native) -->
                <ScrollViewer x:Name="OverlaysView" VerticalScrollBarVisibility="Auto" Padding="28,20,18,24" Background="{StaticResource Bg}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="OvTitle" Style="{StaticResource H1}" Text="OVERLAYS"/>
                        <TextBlock x:Name="OvSub" Style="{StaticResource Note}" Margin="0,0,0,12" Text="Windows on top of the game. Open them here; Auto opens them when you get in the car."/>
                        <Border x:Name="OvWip" Style="{StaticResource Card}" Visibility="Collapsed" BorderBrush="{StaticResource Accent}">
                            <TextBlock x:Name="OvWipText" Style="{StaticResource Note}" Text="In development: overlays are for admins for now."/>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <WrapPanel>
                                    <Button x:Name="OvLock" Style="{StaticResource BtnPrimary}" Content="Move overlays" Click="OnOvLock"/>
                                    <Button x:Name="OvReset" Style="{StaticResource Btn}" Content="Reset positions" Click="OnOvReset"/>
                                    <Button x:Name="OvCloseAll" Style="{StaticResource Btn}" Content="Close all" Click="OnOvCloseAll"/>
                                    <StackPanel Orientation="Horizontal" Margin="12,0,0,6" VerticalAlignment="Center">
                                        <TextBlock x:Name="OvAlphaL" Style="{StaticResource Label}" Margin="0,0,8,0" VerticalAlignment="Center" Text="OPACITY"/>
                                        <Slider x:Name="OvAlpha" Width="160" Minimum="40" Maximum="255" VerticalAlignment="Center" PreviewMouseUp="OnOvAlpha"/>
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock x:Name="OvPresetsL" Style="{StaticResource Label}" Text="PRESETS"/>
                                <WrapPanel x:Name="OvPresets"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBox x:Name="OvPresetName" Width="200" Padding="6,4" Margin="0,0,6,6" Background="{StaticResource Surface2}" Foreground="{StaticResource Fg}" BorderBrush="{StaticResource Line}" CaretBrush="{StaticResource Fg}"/>
                                    <Button x:Name="OvPresetSave" Style="{StaticResource Btn}" Content="+ Save current" Click="OnOvPresetSave"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <WrapPanel x:Name="OvCards"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ANALYSIS (native): the lap analyzer and the coach -->
                <ScrollViewer x:Name="AnalysisView" VerticalScrollBarVisibility="Auto" Padding="28,20,18,24" Visibility="Collapsed" Background="{StaticResource Bg}">
                    <StackPanel>
                        <TextBlock x:Name="AnaTitle" Style="{StaticResource H1}" Text="ANALYSIS"/>
                        <WrapPanel Margin="0,0,0,8">
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock x:Name="AnaSessL" Style="{StaticResource Label}" Margin="0,0,0,2" Text="SESSION"/>
                                <ComboBox x:Name="AnaSess" Width="420" SelectionChanged="OnAnaSess"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Style="{StaticResource Label}" Margin="0,0,0,2" Text="A"/>
                                <ComboBox x:Name="AnaA" Width="200" SelectionChanged="OnAnaLap"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Style="{StaticResource Label}" Margin="0,0,0,2" Text="B"/>
                                <ComboBox x:Name="AnaB" Width="240" SelectionChanged="OnAnaLap"/>
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock x:Name="AnaMsg" Style="{StaticResource Note}" Margin="0,0,0,8" Visibility="Collapsed"/>
                        <StackPanel x:Name="AnaBody" Visibility="Collapsed">
                            <!-- the gap and its key facts -->
                            <Border Style="{StaticResource Card}">
                                <WrapPanel x:Name="AnaFacts"/>
                            </Border>
                            <!-- the charts along the lap -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="AnaSpeedT" Style="{StaticResource CardTitle}" Text="SPEED"/>
                                    <Canvas x:Name="AnaSpeed" Height="170" ClipToBounds="True" SizeChanged="OnAnaResize"/>
                                    <TextBlock x:Name="AnaPedT" Style="{StaticResource CardTitle}" Margin="0,12,0,8" Text="THROTTLE AND BRAKE"/>
                                    <Canvas x:Name="AnaPedals" Height="110" ClipToBounds="True"/>
                                    <TextBlock x:Name="AnaDeltaT" Style="{StaticResource CardTitle}" Margin="0,12,0,8" Text="TIME DELTA (A − B)"/>
                                    <Canvas x:Name="AnaDelta" Height="110" ClipToBounds="True"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border Width="14" Height="4" Background="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="AnaLegA" Style="{StaticResource Note}" Margin="0,0,16,0" Text="A"/>
                                        <Border Width="14" Height="4" Background="{StaticResource Blue}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="AnaLegB" Style="{StaticResource Note}" Text="B"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- the track map: the road, where A gains or loses, both laps' braking points, the incidents, the coach's corners and the two lines -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="AnaMapT" Style="{StaticResource CardTitle}" Text="TRACK MAP"/>
                                    <WrapPanel x:Name="AnaMapBar" Margin="0,0,0,6"/>
                                    <Viewbox x:Name="AnaMapBox" Stretch="Uniform" MaxWidth="720" HorizontalAlignment="Center">
                                        <Canvas x:Name="AnaMap" Width="600" Height="360" ClipToBounds="True"/>
                                    </Viewbox>
                                    <TextBlock x:Name="AnaMapNote" Style="{StaticResource Note}" Margin="0,6,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                            <!-- the corners that cost the most -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="AnaCoachT" Style="{StaticResource CardTitle}" Text="WHERE A LOSES TIME"/>
                                    <StackPanel x:Name="AnaTips"/>
                                </StackPanel>
                            </Border>
                            <!-- every lap of the session -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="AnaLapsT" Style="{StaticResource CardTitle}" Text="LAPS"/>
                                    <StackPanel x:Name="AnaLaps"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Button x:Name="AnaMore" Style="{StaticResource Btn}" HorizontalAlignment="Left" Content="Map, sectors and more in the full analyzer" Click="OnAnaMore"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- COMMUNITY (native): the leaderboards -->
                <ScrollViewer x:Name="CommunityView" VerticalScrollBarVisibility="Auto" Padding="28,20,18,24" Visibility="Collapsed" Background="{StaticResource Bg}">
                    <StackPanel>
                        <TextBlock x:Name="ComTitle" Style="{StaticResource H1}" Text="COMMUNITY"/>
                        <TextBlock x:Name="ComSub" Style="{StaticResource Note}" Margin="0,0,0,12" Text="Leaderboards by lap time: the fastest lap of each car and track in every account, shared by itself."/>
                        <WrapPanel x:Name="ComDisc" Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,8">
                            <TextBox x:Name="ComSearch" Width="220" Padding="8,6" Margin="0,0,8,6" Background="{StaticResource Surface2}" Foreground="{StaticResource Fg}" BorderBrush="{StaticResource Line}" CaretBrush="{StaticResource Fg}" TextChanged="OnComFilter"/>
                            <ComboBox x:Name="ComTrack" Width="300" Margin="0,0,8,6" SelectionChanged="OnComTrack"/>
                            <ComboBox x:Name="ComCar" Width="300" Margin="0,0,8,6" SelectionChanged="OnComCar"/>
                            <Button x:Name="ComTrkBtn" Style="{StaticResource Btn}" Margin="0,0,8,6" Content="Track page" Click="OnComTrackPage"/>
                        </WrapPanel>
                        <!-- the track page: the map with the official turns, the drivers and laps, the record of every car -->
                        <Border x:Name="ComTrkCard" Style="{StaticResource Card}" Margin="0,0,0,10" Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="ComTrkClose" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Close" Click="OnComTrackClose"/>
                                    <TextBlock x:Name="ComTrkT" Style="{StaticResource CardTitle}" VerticalAlignment="Center" Text="TRACK"/>
                                </DockPanel>
                                <TextBlock x:Name="ComTrkSub" Style="{StaticResource Note}" Margin="0,2,0,6"/>
                                <Viewbox x:Name="ComTrkMapBox" Stretch="Uniform" MaxWidth="720" HorizontalAlignment="Center">
                                    <Canvas x:Name="ComTrkMap" Width="600" Height="360" ClipToBounds="True"/>
                                </Viewbox>
                                <TextBlock x:Name="ComTrkNote" Style="{StaticResource Note}" Visibility="Collapsed"/>
                                <TextBlock x:Name="ComTrkRecT" Style="{StaticResource Label}" Margin="0,10,0,4" Text="RECORD PER CAR"/>
                                <StackPanel x:Name="ComTrkRows"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="ComRecT" Style="{StaticResource CardTitle}" Text="RECENT RECORDS"/>
                                <TextBlock x:Name="ComRecSub" Style="{StaticResource Note}" Margin="0,0,0,6" Text="The fastest lap of every car and track, the newest first."/>
                                <StackPanel x:Name="ComRecRows"/>
                                <TextBlock x:Name="ComRecEmpty" Style="{StaticResource Note}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="ComBoardT" Style="{StaticResource CardTitle}" Text="LEADERBOARD"/>
                                <StackPanel x:Name="ComRows"/>
                                <TextBlock x:Name="ComEmpty" Style="{StaticResource Note}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="ComMore" Style="{StaticResource Btn}" HorizontalAlignment="Left" Content="Profiles, race summaries and leagues" Click="OnComMore"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ACCOUNT (native) -->
                <ScrollViewer x:Name="AccountView" VerticalScrollBarVisibility="Auto" Padding="28,20,18,24" Visibility="Collapsed" Background="{StaticResource Bg}">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock x:Name="AccTitle" Style="{StaticResource H1}" Text="ACCOUNT"/>
                        <!-- signed out: sign in -->
                        <Border x:Name="AccSignIn" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="AccSignInT" Style="{StaticResource CardTitle}" Text="SIGN IN"/>
                                <TextBlock x:Name="AccEmailL" Style="{StaticResource Label}" Text="EMAIL"/>
                                <TextBox x:Name="AccEmail" Padding="8,6" Background="{StaticResource Surface2}" Foreground="{StaticResource Fg}" BorderBrush="{StaticResource Line}" CaretBrush="{StaticResource Fg}" FontSize="14"/>
                                <TextBlock x:Name="AccPassL" Style="{StaticResource Label}" Text="PASSWORD"/>
                                <PasswordBox x:Name="AccPass" Padding="8,6" Background="{StaticResource Surface2}" Foreground="{StaticResource Fg}" BorderBrush="{StaticResource Line}" CaretBrush="{StaticResource Fg}" FontSize="14"/>
                                <StackPanel x:Name="AccCodeBox" Visibility="Collapsed">
                                    <TextBlock x:Name="AccCodeL" Style="{StaticResource Label}" Text="CODE FROM YOUR AUTHENTICATOR APP"/>
                                    <TextBox x:Name="AccCode" Padding="8,6" Background="{StaticResource Surface2}" Foreground="{StaticResource Fg}" BorderBrush="{StaticResource Line}" CaretBrush="{StaticResource Fg}" FontSize="14"/>
                                </StackPanel>
                                <TextBlock x:Name="AccErr" Foreground="{StaticResource Bad}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button x:Name="AccLogin" Style="{StaticResource BtnPrimary}" Content="Sign in" Click="OnAccLogin" IsDefault="True"/>
                                    <Button x:Name="AccCreate" Style="{StaticResource Btn}" Content="Create an account" Click="OnAccMore"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <!-- signed in -->
                        <StackPanel x:Name="AccIn" Visibility="Collapsed">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="AccNameL" Style="{StaticResource CardTitle}" Text="PUBLIC NAME"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="AccName" Width="260" Padding="8,6" Margin="0,0,8,0" Background="{StaticResource Surface2}" Foreground="{StaticResource Fg}" BorderBrush="{StaticResource Line}" CaretBrush="{StaticResource Fg}" FontSize="14"/>
                                        <Button x:Name="AccNameSave" Style="{StaticResource Btn}" Content="Save" Click="OnAccName" Margin="0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="AccNameNote" Style="{StaticResource Note}" Margin="0,6,0,0" Text="Changing it here changes it everywhere, your shared laps too."/>
                                    <TextBlock x:Name="AccEmailT" Style="{StaticResource Label}" Text="EMAIL"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="AccEmailV" Style="{StaticResource Value}" FontSize="15" Text="••••••"/>
                                        <Button x:Name="AccReveal" Style="{StaticResource Btn}" Content="Show" Margin="10,0,0,0" Click="OnAccReveal"/>
                                    </StackPanel>
                                    <WrapPanel x:Name="AccFlags" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="AccSyncErr" Foreground="{StaticResource Bad}" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10"/>
                                    <WrapPanel>
                                        <Button x:Name="AccOut" Style="{StaticResource Btn}" Content="Sign out on this PC" Click="OnAccOut"/>
                                        <Button x:Name="AccMore" Style="{StaticResource Btn}" Content="More (password, two-step sign-in, devices, admin)" Click="OnAccMore"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="AccDiscT" Style="{StaticResource CardTitle}" Text="DISCORD"/>
                                    <TextBlock x:Name="AccDiscV" Style="{StaticResource Note}" TextWrapping="Wrap"/>
                                    <CheckBox x:Name="AccDiscShow" Foreground="{StaticResource Fg}" FontSize="14" Margin="0,8,0,0" Content="Show my Discord on my profile" Visibility="Collapsed" Click="OnAccDiscShow"/>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button x:Name="AccDiscGo" Style="{StaticResource BtnPrimary}" Content="Link Discord" Click="OnAccDiscGo" Visibility="Collapsed"/>
                                        <Button x:Name="AccDiscOff" Style="{StaticResource Btn}" Content="Unlink" Click="OnAccDiscOff" Visibility="Collapsed"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- SETTINGS (native) -->
                <ScrollViewer x:Name="SettingsView" VerticalScrollBarVisibility="Auto" Padding="28,20,18,24" Visibility="Collapsed" Background="{StaticResource Bg}">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock x:Name="SetTitle" Style="{StaticResource H1}" Text="SETTINGS"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="SetGenT" Style="{StaticResource CardTitle}" Text="GENERAL"/>
                                <CheckBox x:Name="SetStart" Foreground="{StaticResource Fg}" FontSize="14" Margin="0,4" Content="Start with Windows" Click="OnSetStart"/>
                                <CheckBox x:Name="SetCloseOv" Foreground="{StaticResource Fg}" FontSize="14" Margin="0,4" Content="Close the overlays when Pitlane HQ closes" Click="OnSetCloseOv"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="VR"/>
                                <CheckBox x:Name="SetVR" Foreground="{StaticResource Fg}" FontSize="14" Margin="0,4" Content="Show the overlays in VR (SteamVR)" Click="OnSetVR"/>
                                <TextBlock x:Name="SetVRNote" Style="{StaticResource Note}" Margin="0,4,0,6" Text="Every open overlay also shows in the headset, where it is on your main screen."/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock x:Name="SetVRDistL" Style="{StaticResource Label}" Width="200" VerticalAlignment="Center" Text="DISTANCE"/>
                                    <Slider x:Name="SetVRDist" Width="200" Minimum="0.3" Maximum="3" VerticalAlignment="Center" PreviewMouseUp="OnSetVRSlide" ValueChanged="OnSetVRShow"/>
                                    <TextBlock x:Name="SetVRDistV" Style="{StaticResource Note}" Width="60" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock x:Name="SetVRSizeL" Style="{StaticResource Label}" Width="200" VerticalAlignment="Center" Text="SIZE"/>
                                    <Slider x:Name="SetVRSize" Width="200" Minimum="0.3" Maximum="4" VerticalAlignment="Center" PreviewMouseUp="OnSetVRSlide" ValueChanged="OnSetVRShow"/>
                                    <TextBlock x:Name="SetVRSizeV" Style="{StaticResource Note}" Width="60" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock x:Name="SetVRHeightL" Style="{StaticResource Label}" Width="200" VerticalAlignment="Center" Text="HEIGHT"/>
                                    <Slider x:Name="SetVRHeight" Width="200" Minimum="-1" Maximum="1" VerticalAlignment="Center" PreviewMouseUp="OnSetVRSlide" ValueChanged="OnSetVRShow"/>
                                    <TextBlock x:Name="SetVRHeightV" Style="{StaticResource Note}" Width="60" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="SetUpdT" Style="{StaticResource CardTitle}" Text="UPDATES"/>
                                <TextBlock x:Name="SetUpdV" Style="{StaticResource Note}"/>
                                <TextBlock x:Name="SetUpdNew" Style="{StaticResource Note}" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                                <CheckBox x:Name="SetUpdAuto" Foreground="{StaticResource Fg}" FontSize="14" Margin="0,8,0,4" Content="Install updates by themselves when no sim is running" Click="OnSetUpdAuto"/>
                                <WrapPanel Margin="0,6,0,0">
                                    <Button x:Name="SetUpdCheck" Style="{StaticResource Btn}" Content="Check now" Click="OnSetUpdCheck"/>
                                    <Button x:Name="SetUpdApply" Style="{StaticResource BtnPrimary}" Content="Update now" Click="OnSetUpdApply" Visibility="Collapsed"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="SetMoreT" Style="{StaticResource CardTitle}" Text="MORE"/>
                                <TextBlock x:Name="SetMoreNote" Style="{StaticResource Note}" Text="Language and units, the race engineer's voice, the phone, notifications and About."/>
                                <Button x:Name="SetMore" Style="{StaticResource Btn}" Content="Open all the settings" Margin="0,10,0,0" HorizontalAlignment="Left" Click="OnSetMore"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel x:Name="Starting" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="StartingText" Text="Starting the Pitlane HQ engine…" Foreground="{StaticResource Muted}" FontSize="14"/>
                    <TextBlock x:Name="StartError" Foreground="{StaticResource Bad}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="520"/>
                </StackPanel>
            </Grid>
        </Grid>

    </Grid>
</Window>
