<Window x:Class="PitlaneHQ.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Pitlane HQ" Width="1360" Height="860" MinWidth="900" MinHeight="600"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded" Closing="OnClosing">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- title bar: the app's own -->
        <Grid Grid.Row="0" Background="{StaticResource Surface}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                <TextBlock Text="PITLANE HQ" Foreground="{StaticResource Fg}" FontWeight="Black" FontSize="15" VerticalAlignment="Center"/>
                <Border Background="{StaticResource Surface2}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionText" Text="desktop preview" Foreground="{StaticResource Muted}" FontSize="10" FontFamily="Consolas"/>
                </Border>
                <Border x:Name="DemoPill" Visibility="Collapsed" Background="{StaticResource Accent}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="DEMO DATA" Foreground="{StaticResource Bg}" FontSize="10" FontWeight="Black"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource WinButton}" Content="&#xE921;" Click="OnMinimize"/>
                <Button Style="{StaticResource WinButton}" Content="&#xE922;" Click="OnMaximize"/>
                <Button Style="{StaticResource WinButton}" Content="&#xE8BB;" Click="OnClose"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- navigation -->
            <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,10">
                    <RadioButton Style="{StaticResource NavButton}" Content="Home" Tag="home" IsChecked="True" Checked="OnNav"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Live" Tag="live" Checked="OnNav"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Analysis" Tag="laps" Checked="OnNav"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Coach" Tag="coach" Checked="OnNav"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="My races" Tag="races" Checked="OnNav"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Community" Tag="community" Checked="OnNav"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Overlays" Tag="overlays" Checked="OnNav"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Account" Tag="me" Checked="OnNav"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Settings" Tag="settings" Checked="OnNav"/>
                </StackPanel>
            </Border>

            <!-- content: the native Home card above the web app; other screens are the web app for now -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border x:Name="HomeCard" Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Margin="16,16,16,0" Padding="18,12,18,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Label}" Text="GAME"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ConnDot" Width="10" Height="10" Fill="{StaticResource Bad}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ConnText" Style="{StaticResource Value}" Text="Waiting for iRacing"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Label}" Text="TRACK"/>
                            <TextBlock x:Name="TrackText" Style="{StaticResource Value}" Text="–"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Label}" Text="CAR"/>
                            <TextBlock x:Name="CarText" Style="{StaticResource Value}" Text="–"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#11151B"/>
                    <StackPanel x:Name="Starting" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Starting the Pitlane HQ engine…" Foreground="{StaticResource Muted}" FontSize="14"/>
                        <TextBlock x:Name="StartError" Foreground="{StaticResource Bad}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="520"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- status bar -->
        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <TextBlock x:Name="EngineText" Text="Engine: starting" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock x:Name="AccountText" Text="" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
