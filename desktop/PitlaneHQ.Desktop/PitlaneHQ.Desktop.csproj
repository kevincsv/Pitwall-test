<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- the icon in the notification area (Tray.cs, NotifyIcon) -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- the DPI awareness stays in app.manifest, where WPF reads it -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PitlaneHQ.Desktop</AssemblyName>
    <RootNamespace>PitlaneHQ.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\pitlanehq.ico</ApplicationIcon>
    <Version>0.5.2</Version>
    <Company>Pitlane HQ</Company>
    <Product>Pitlane HQ</Product>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- the app's fonts, the same files the native overlays draw with -->
  <ItemGroup>
    <Resource Include="..\..\ovfonts\*.ttf" Link="fonts\%(Filename)%(Extension)" />
    <!-- the logo in the header, rendered from assets/logo.svg -->
    <Resource Include="img\logo.png" />
  </ItemGroup>

  <!-- WPF's names stay the plain ones: Windows Forms only by its full name (Tray.cs) -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- the notification area's icon, the app's own -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\pitlanehq.ico" LogicalName="pitlanehq.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

</Project>
